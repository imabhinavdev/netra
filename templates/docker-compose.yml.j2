# Docker Compose - generated by Netra
services:
{% if install_prometheus %}
  prometheus:
    image: {{ image_prometheus }}
    container_name: netra-prometheus
    ports:
      - "{{ bind_ip }}:{{ port_prometheus }}:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
      - prometheus_data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.enable-lifecycle'
    restart: unless-stopped
{% endif %}

{% if install_grafana %}
  grafana:
    image: {{ image_grafana }}
    container_name: netra-grafana
    ports:
      - "{{ bind_ip }}:{{ port_grafana }}:3000"
    environment:
      - GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_SERVER_HTTP_PORT=3000
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana-provisioning:/etc/grafana/provisioning/dashboards:ro
    restart: unless-stopped
{% endif %}

{% if install_loki %}
  loki:
    image: {{ image_loki }}
    container_name: netra-loki
    ports:
      - "{{ bind_ip }}:{{ port_loki }}:3100"
    volumes:
      - ./loki.yml:/etc/loki/local-config.yaml
      - loki_data:/loki
    command: -config.file=/etc/loki/local-config.yaml
    restart: unless-stopped
{% endif %}

{% if install_promtail %}
  promtail:
    image: {{ image_promtail }}
    container_name: netra-promtail
    volumes:
      - ./promtail.yml:/etc/promtail/config.yml
      - /var/log:/var/log:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    command: -config.file=/etc/promtail/config.yml
    restart: unless-stopped
{% endif %}

{% if install_node_exporter %}
  node-exporter:
    image: {{ image_node_exporter }}
    container_name: netra-node-exporter
    ports:
      - "{{ bind_ip }}:{{ port_node_exporter }}:9100"
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - '--path.procfs=/host/proc'
      - '--path.sysfs=/host/sys'
      - '--path.rootfs=/rootfs'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
    restart: unless-stopped
{% endif %}

volumes:
  prometheus_data:
  grafana_data:
  loki_data:

# Promtail configuration - generated by Netra
server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: {{ loki_push_url }}

scrape_configs:
{% if logs_docker %}
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: 'container'
      - source_labels: ['__meta_docker_container_log_stream']
        target_label: 'logstream'
{% endif %}
{% if logs_system %}
  - job_name: system
    static_configs:
      - targets:
          - localhost
        labels:
          job: varlogs
          __path__: /var/log/*.log
{% endif %}
{% for path in logs_custom_paths %}
  - job_name: custom_{{ loop.index }}
    static_configs:
      - targets:
          - localhost
        labels:
          __path__: {{ path }}/*
{% endfor %}
